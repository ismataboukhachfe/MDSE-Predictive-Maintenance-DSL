   </extension>

   <extension point="org.eclipse.ui.editors">
      <!-- @generated maintenanceSystem -->
      <editor
            id="maintenanceSystem.presentation.MaintenanceSystemEditorID"
            name="%_UI_MaintenanceSystemEditor_label"
            icon="icons/full/obj16/MaintenanceSystemModelFile.gif"
            extensions="maintenancesystem"
            class="maintenanceSystem.presentation.MaintenanceSystemEditor"
            contributorClass="maintenanceSystem.presentation.MaintenanceSystemActionBarContributor">
