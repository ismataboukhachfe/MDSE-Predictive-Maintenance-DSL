   <extension point="org.eclipse.ui.newWizards">
      <!-- @generated maintenanceSystem -->
      <category
            id="org.eclipse.emf.ecore.Wizard.category.ID"
            name="%_UI_Wizard_category"/>
      <wizard
            id="maintenanceSystem.presentation.MaintenanceSystemModelWizardID"
            name="%_UI_MaintenanceSystemModelWizard_label"
